{
  "id": "com.officeutils.mm-conversation-export",
  "name": "Mattermost Conversation Export",
  "description": "Self-service export of participating DMs and opt-in, authorized current public/private channels.",
  "version": "0.0.0-dev",
  "min_server_version": "10.11.2",
  "settings_schema": {
    "header": "Message export settings",
    "settings": [
      {
        "key": "MaxExportPosts",
        "display_name": "Maximum posts per export",
        "type": "text",
        "help_text": "Maximum number of messages included in one export (1-10000).",
        "default": "1000"
      },
      {
        "key": "EnableChannelExport",
        "display_name": "Enable channel export",
        "type": "bool",
        "help_text": "Opt in to /export-channel for the current public, private, or direct channel. Membership and read permission are always required.",
        "default": false
      }
    ]
  },
  "server": {
    "executables": {
      "linux-amd64": "server/dist/plugin-linux-amd64",
      "linux-arm64": "server/dist/plugin-linux-arm64",
      "darwin-amd64": "server/dist/plugin-darwin-amd64",
      "darwin-arm64": "server/dist/plugin-darwin-arm64",
      "windows-amd64": "server/dist/plugin-windows-amd64.exe"
    }
  }
}
